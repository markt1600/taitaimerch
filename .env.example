# Your store's permanent domain (not the custom domain).
SHOPIFY_STORE_DOMAIN=your-store.myshopify.com

# Storefront API token — powers the product grid and "Buy now" checkout.
# Shopify admin → Headless sales channel (or a custom app's Storefront API).
SHOPIFY_STOREFRONT_ACCESS_TOKEN=

# Admin app credentials — powers the email signup (creates a tagged customer).
SHOPIFY_CLIENT_ID=
SHOPIFY_CLIENT_SECRET=

# Any random string; used in the webhook URL that refreshes products.
SHOPIFY_REVALIDATION_SECRET=
